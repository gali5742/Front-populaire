{
  "name": "front-populaire",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "build:offline": "node scripts/build-offline.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:registry && npm test && npm run build && npm run build:offline"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
